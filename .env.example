# Copy to .env locally. Never commit real credentials.

LEGION_ENV=development
LEGION_DATABASE_PATH=data/runtime/legion_x.sqlite3
LEGION_OUTPUT_DIR=outputs
LEGION_TIMEZONE=Asia/Kolkata
LEGION_DAILY_REELS=3
LEGION_MIN_QA_SCORE=80

# Local model endpoints (optional)
TEXT_MODEL_BASE_URL=
IMAGE_MODEL_BASE_URL=
TTS_MODEL_BASE_URL=

# Platform credentials are added only when publishing integrations are enabled.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
